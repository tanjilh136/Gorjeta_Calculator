; Mistu Gorjetas - Inno Setup 6 script
; Designed by Optivex Labs
;
; Built by build.py:  ISCC.exe /DAppVersion=1.0.0 MistuGorjetas.iss
; Expects the PyInstaller output in ..\dist\MistuGorjetas\ and the key hash
; in key_hash.iss (generated by build.py - it never contains the key itself).

#define AppName "Mistu Gorjetas"
#define AppExe "MistuGorjetas.exe"
#define AppPublisher "Optivex Labs"
#ifndef AppVersion
  #define AppVersion "1.0.0"
#endif

#include "key_hash.iss"
#if KeyHash == ""
  #error No install key configured. Run "python build.py" to set it.
#endif

[Setup]
AppId={{5B8E2C7A-3F41-4D6B-9A0E-6C2F1D8B4E73}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
DisableWelcomePage=no
DisableDirPage=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0
PrivilegesRequired=admin
AppMutex=MistuGorjetasAppMutex
OutputDir=..\dist
OutputBaseFilename=MistuGorjetas_Setup
SetupIconFile=..\assets\app.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
VersionInfoVersion={#AppVersion}
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} Setup
VersionInfoProductName={#AppName}
VersionInfoCopyright=Designed by Optivex Labs

[Languages]
Name: "portuguese"; MessagesFile: "compiler:Languages\Portuguese.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
english.WelcomeLabel2=This will install [name/ver] on your computer.%n%nYou will need the installation key to continue.%n%n%nDesigned by Optivex Labs
portuguese.WelcomeLabel2=Será instalado o [name/ver] neste computador.%n%nVai precisar da chave de instalação para continuar.%n%n%nDesigned by Optivex Labs

[Dirs]
; Machine-wide folder for the activation record; the app (running as a normal
; user) must be able to write it.
Name: "{commonappdata}\MistuGorjetas"; Permissions: users-modify

[Files]
Source: "..\dist\MistuGorjetas\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "Designed by Optivex Labs"
Name: "{autoprograms}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Comment: "Designed by Optivex Labs"

[Run]
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent

[Code]
{ Password page: Inno Setup shows it automatically because CheckPassword exists.
  The typed key is hashed exactly like build.py does (installer_hash_hex):
    h = sha256(salt + key); repeat (N - 1) times: h = sha256(salt + h) }
function CheckPassword(Password: String): Boolean;
var
  H: String;
  I: Integer;
begin
  H := Lowercase(GetSHA256OfString('{#KeySalt}' + Password));
  for I := 2 to {#KeyIterations} do
    H := Lowercase(GetSHA256OfString('{#KeySalt}' + H));
  Result := (H = '{#KeyHash}');
end;
